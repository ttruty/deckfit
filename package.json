{
  "name": "deckfit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "content:build": "python3 tools/build_content.py",
    "content:preview": "node tools/build_preview.mjs",
    "content:shots": "node tools/shot.cjs",
    "start:local": "ng serve --configuration local",
    "e2e": "playwright test",
    "contrast": "node tools/check_contrast.mjs",
    "serve:pwa": "ng build && npx --yes http-server dist/deckfit/browser -p 4311 -c-1 --silent",
    "check:realtime": "node tools/check_realtime.mjs",
    "build:pages": "node tools/build_pages.mjs",
    "icons": "node tools/build_icons.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.4.6",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
